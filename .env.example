# Copy to .env. Never commit .env.

# Hosted Models (required for any OpenRouter Model). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Models (optional). Default is the standard Ollama address.
OLLAMA_HOST=http://127.0.0.1:11434
# Context window for local models (Ollama's own default of 4096 is too small for retrieval).
# RAMPART_OLLAMA_NUM_CTX=16384
# Let local models think before answering (better answers, much slower on a CPU).
# RAMPART_OLLAMA_THINKING=false

# Tracing (optional). Without these keys Rampart writes JSONL traces to data/traces/.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Application settings (all optional).
# RAMPART_DATA_DIR=data
# RAMPART_MODELS_FILE=models.yaml
# RAMPART_HOST=127.0.0.1
# RAMPART_PORT=8000
# RAMPART_COOKIE_SECURE=false
# RAMPART_SESSION_TTL_HOURS=168
# RAMPART_APP_URL=http://127.0.0.1:8000
# Login throttling: failed sign-ins allowed per username and per client address in the window.
# RAMPART_LOGIN_WINDOW_MINUTES=15
# RAMPART_LOGIN_MAX_FAILURES_PER_USER=5
# RAMPART_LOGIN_MAX_FAILURES_PER_CLIENT=30
# Only behind a reverse proxy that sets X-Forwarded-For; otherwise clients could pick an address.
# RAMPART_TRUST_PROXY_HEADERS=false

# Knowledge Base (all optional).
# RAMPART_MAX_UPLOAD_BYTES=5242880
# RAMPART_MAX_UPLOADS_PER_USER=50
# RAMPART_RETRIEVAL_K=6
# RAMPART_MAX_REWRITES=2

# Trace retention (optional). When set, local JSONL traces older than this many days are deleted
# when the server starts. `rampart traces prune --older-than DAYS` deletes on demand.
# RAMPART_TRACE_RETENTION_DAYS=30

# Plugins (all optional). The catalog file is the only place a Plugin's command is defined.
# RAMPART_PLUGINS_CATALOG=plugins/catalog.yaml
# RAMPART_PLUGIN_TIMEOUT_SECONDS=20
